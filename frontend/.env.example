# ===== RUANGAMAN Frontend Environment Variables =====
# Salin file ini menjadi .env.local dan isi nilainya
# JANGAN commit file .env.local ke repository!

# URL Backend API (ganti dengan URL Vercel backend setelah deployment)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Supabase Configuration
# Dapatkan dari: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key

# Demo Login Admin (opsional — hanya untuk development)
# Set ke "true" untuk menampilkan form login demo di halaman admin
# Di production, biarkan false atau hilangkan variabel ini
VITE_ENABLE_DEMO_AUTH=false
