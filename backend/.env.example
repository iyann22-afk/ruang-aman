# ===== RUANGAMAN Backend Environment Variables =====
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke repository!

# Lingkungan server
NODE_ENV=development
PORT=4000

# URL Frontend (untuk CORS)
FRONTEND_URL=http://localhost:5173

# Supabase Configuration
# Dapatkan dari: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key

# Aktifkan Supabase di development (opsional)
# Set ke "true" untuk gunakan Supabase meski NODE_ENV=development
USE_SUPABASE=false

# Demo Admin Login (hanya untuk development atau testing)
# Di production, JANGAN set ENABLE_DEMO_AUTH=true
# Endpoint /auth/login dan form demo akan nonaktif otomatis di production
DEMO_ADMIN_EMAIL=admin@ruangaman.id
DEMO_ADMIN_PASSWORD=demo-password-not-for-production
ENABLE_DEMO_AUTH=false
